<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PcHealth.App</RootNamespace>
    <AssemblyName>PcHealthCheck</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Required by the LibraryImport source generator (named-pipe client PID lookup, worker confirmation dialog). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Release publishes must not drag along the debug symbols of native dependencies:
      SkiaSharp and HarfBuzz alone add ~100 MB of .pdb files that no user needs.
    -->
    <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'">none</AllowedReferenceRelatedFileExtensions>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <Description>PC Health Check — offline-by-default, read-only-by-default PC health auditor. Unprivileged UI process (asInvoker); elevation only ever happens through the explicit worker flow (M2).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcHealth.Core\PcHealth.Core.csproj" />
    <ProjectReference Include="..\PcHealth.Ipc\PcHealth.Ipc.csproj" />
    <ProjectReference Include="..\PcHealth.Modules.Windows\PcHealth.Modules.Windows.csproj" />
  </ItemGroup>

  <!--
    SkiaSharp and HarfBuzz ship native debug symbols as package assets, which land in the
    publish folder and add ~100 MB to every release download. Nothing needs them at runtime.
  -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
