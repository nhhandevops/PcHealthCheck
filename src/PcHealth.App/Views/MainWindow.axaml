<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PcHealth.App.ViewModels"
        x:Class="PcHealth.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PC Health Check"
        Width="1240" Height="820" MinWidth="980" MinHeight="620">

  <Window.Resources>
    <!-- Shared so the "no admin needed" and "needs administrator" groups render
         identical cards without the markup existing twice. -->
      <DataTemplate x:Key="ModuleCard" x:DataType="vm:ModuleRowViewModel">
        <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,8">
          <StackPanel Spacing="3">
            <CheckBox IsChecked="{Binding IsSelected}" Padding="6,0,0,0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            </CheckBox>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
            <TextBlock Text="{Binding ReadsText}" TextWrapping="Wrap" Opacity="0.55" FontSize="11" />
            <!-- Wraps rather than runs off the card: the WRITES badge carries a full path
                 and size, which no fixed-width row can hold. -->
            <WrapPanel ItemSpacing="6" LineSpacing="4">
              <Border IsVisible="{Binding NeedsAdmin}" Background="#c62828" CornerRadius="4" Padding="5,1">
                <TextBlock Text="ADMIN" Foreground="White" FontSize="10" FontWeight="SemiBold" />
              </Border>
              <Border IsVisible="{Binding HasWrites}" Background="#b8860b" CornerRadius="4" Padding="5,1">
                <TextBlock Text="{Binding WritesText}" Foreground="White" FontSize="10" />
              </Border>
              <Border IsVisible="{Binding NeedsInternet}" Background="#1565c0" CornerRadius="4" Padding="5,1">
                <TextBlock Text="INTERNET" Foreground="White" FontSize="10" FontWeight="SemiBold" />
              </Border>
              <Border IsVisible="{Binding LoadsDriver}" Background="#6a1b9a" CornerRadius="4" Padding="5,1">
                <TextBlock Text="KERNEL DRIVER" Foreground="White" FontSize="10" FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="{Binding DurationText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </DataTemplate>
  </Window.Resources>


  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="PC Health Check" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Opacity="0.7" TextWrapping="Wrap"
                 Text="Offline by default — nothing leaves this PC. Read-only by default — your files and documents are never opened. Every check below runs only with your consent." />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Background="#20808080" CornerRadius="6" Padding="10,6" Margin="0,12,0,0">
      <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <Grid ColumnDefinitions="430,16,*">

      <!-- Consent matrix -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryLine}" TextWrapping="Wrap"
                   FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />

        <!-- Optional dependency offer: install is consented, shows the exact command,
             and everything installed here is offered for removal again at exit. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasDependencyOffer}"
                Background="#156a1b9a" BorderBrush="#806a1b9a" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="0,0,6,8">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding DependencyOfferText}" TextWrapping="Wrap" FontSize="12" />
            <!-- A Grid, not a horizontal stack: a stack hands its children unlimited width,
                 so this caption never wrapped and spilled outside the banner. -->
            <Grid ColumnDefinitions="Auto,*">
              <Button Grid.Column="0" Content="Install…" Command="{Binding InstallDependencyCommand}"
                      FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="8,0,0,0"
                         Text="Shows the exact command first · one UAC prompt · uses the internet"
                         FontSize="11" Opacity="0.65" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">

          <!-- On-demand scans. Separate from the health scan because these take minutes
               and ask Defender to act, rather than only reading what it already knows.
               Collapsed by default: expanded, this panel squeezed the list of checks above
               it down to two visible rows out of twenty-four, which made a check the user
               was looking for effectively unfindable. -->
          <Expander Header="Scan for malware now" FontSize="13" Margin="0,0,6,0">
            <StackPanel Spacing="6" Margin="0,6,0,0">
              <TextBlock FontSize="11" Opacity="0.65" TextWrapping="Wrap" MaxWidth="370"
                         Text="The checks above read what Defender has already found. These run a fresh scan: a quick scan of the usual hiding places, or one folder of your choosing (read-only — nothing is changed)." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Quick scan…" Command="{Binding RunQuickScanCommand}" FontSize="12" />
                <Button Content="Scan a folder…" Command="{Binding ScanFolderCommand}" FontSize="12" />
                <Button Content="Stop" Command="{Binding CancelMalwareScanCommand}" FontSize="12" />
              </StackPanel>
              <TextBlock Text="{Binding MalwareScanStatus}" IsVisible="{Binding HasMalwareScanStatus}"
                         TextWrapping="Wrap" FontSize="12" MaxWidth="380" />

              <!-- The only internet feature in the app. Off unless the user supplies their
                   own key, and the consent dialog lists every fingerprint before sending. -->
              <Expander Header="Second opinion from VirusTotal (uses the internet)" FontSize="12">
                <StackPanel Spacing="6" Margin="0,6,0,0">
                  <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" MaxWidth="370"
                             Text="Asks about 70 antivirus engines about your startup programs. Only a SHA-256 fingerprint of each file is sent — never the file. Needs your own free API key from virustotal.com; it is kept in memory for this session and never written to disk." />
                  <TextBox Text="{Binding VirusTotalApiKey}" PlaceholderText="Paste your VirusTotal API key"
                           PasswordChar="•" FontSize="12" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Check startup items…" Command="{Binding CheckReputationCommand}" FontSize="12" />
                    <Button Content="Stop" Command="{Binding CancelReputationCheckCommand}" FontSize="12" />
                  </StackPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Expander>

          <CheckBox IsChecked="{Binding RememberTrends}" Padding="6,0,0,0">
            <StackPanel>
              <TextBlock Text="Remember results to spot trends" FontSize="12" />
              <TextBlock Text="Stores only the numbers, in this app's own folder, so it can warn when a failure counter starts growing."
                         FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>
          </CheckBox>
          <!-- Five buttons do not fit this column, so the last one was cut in half. Wrapping
               costs a second row on a narrow window and nothing on a wide one. -->
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Scan now" Command="{Binding ScanCommand}" FontWeight="SemiBold" />
            <Button Content="Cancel" Command="{Binding CancelScanCommand}" />
            <Button Content="Select recommended" Command="{Binding SelectRecommendedCommand}" />
            <Button Content="Clear" Command="{Binding ClearSelectionCommand}" />
            <Button Content="Delete history" Command="{Binding DeleteHistoryCommand}" />
          </WrapPanel>
        </StackPanel>
        <ScrollViewer>
          <StackPanel>
            <!-- Split so the administrator checks are findable at a glance rather than
                 buried at the bottom of twenty-four identical cards. -->
            <TextBlock Text="{Binding StandardHeader}" FontWeight="Bold" FontSize="15"
                       Margin="2,0,0,8" />
            <ItemsControl ItemsSource="{Binding StandardModules}" ItemTemplate="{StaticResource ModuleCard}" />

            <!-- Given a coloured band because the first tester scrolled straight past the
                 plain-text version: a heading nobody notices leaves the administrator checks
                 looking like more of the list above them. -->
            <Border Background="#18c62828" BorderBrush="#60c62828" BorderThickness="0,0,0,2"
                    CornerRadius="6" Padding="8,6" Margin="0,18,6,8">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding AdminHeader}" FontWeight="Bold" FontSize="15" />
                <TextBlock Text="These need administrator rights. Selecting any of them adds one Windows prompt; the main window never runs as administrator."
                           FontSize="11" Opacity="0.75" TextWrapping="Wrap" MaxWidth="360" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding AdminModules}" ItemTemplate="{StaticResource ModuleCard}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- Results -->
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10"
                    IsVisible="{Binding HasResults}">
          <TextBlock Text="Overall:" FontSize="16" VerticalAlignment="Center" />
          <Border Background="{Binding OverallBrush}" CornerRadius="10" Padding="12,3" VerticalAlignment="Center">
            <TextBlock Text="{Binding OverallLabel}" Foreground="White" FontWeight="SemiBold" />
          </Border>
          <Button Content="Export HTML report" Click="OnExportHtml" />
          <Button Content="Export JSON" Click="OnExportJson" />
        </StackPanel>
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock IsVisible="{Binding !HasResults}" Opacity="0.6" Margin="4,20,0,0"
                       Text="Results appear here after a scan. Start by pressing 'Select recommended', then 'Scan now'." />

            <Border IsVisible="{Binding HasIncompleteChecks}" Background="#20b8860b"
                    BorderBrush="#80b8860b" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,6,0">
              <StackPanel Spacing="4">
                <TextBlock Text="Some checks could not finish" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="{Binding IncompleteChecksText}" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />
              </StackPanel>
            </Border>

            <!-- What changed since last time: the signal a single snapshot cannot give. -->
            <Border IsVisible="{Binding HasResults}" BorderBrush="#40808080" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
              <StackPanel Spacing="8">
                <TextBlock Text="What changed since your last scan" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TrendSummary}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                <ItemsControl ItemsSource="{Binding Trends}" IsVisible="{Binding HasTrends}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrendRowViewModel">
                      <Grid ColumnDefinitions="120,*" Margin="0,4,0,4">
                        <Border Grid.Column="0" Background="{Binding GradeBrush}" CornerRadius="6"
                                Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding GradeLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <WrapPanel ItemSpacing="8" LineSpacing="2">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subject}" IsVisible="{Binding HasSubject}" Opacity="0.65" />
                          </WrapPanel>
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" MaxWidth="640" />
                          <ItemsControl ItemsSource="{Binding Tips}" IsVisible="{Binding HasTips}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,1,0,0">
                                  <TextBlock Text="•" Opacity="0.8" />
                                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" MaxWidth="620" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasReputationResults}" BorderBrush="#40808080" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
              <StackPanel Spacing="8">
                <TextBlock Text="Second opinion — VirusTotal" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ReputationHeadline}" TextWrapping="Wrap" FontSize="12" MaxWidth="700" />
                <ItemsControl ItemsSource="{Binding ReputationResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReputationRowViewModel">
                      <Grid ColumnDefinitions="120,*" Margin="0,4,0,4">
                        <Border Grid.Column="0" Background="{Binding Brush}" CornerRadius="6"
                                Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Label}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" MaxWidth="640" Opacity="0.85" />
                          <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas,Courier New,monospace"
                                     FontSize="10" Opacity="0.5" TextWrapping="Wrap" MaxWidth="640" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding CategoryCards}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CategoryCardViewModel">
                  <Border BorderBrush="#40808080" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,10">
                    <StackPanel Spacing="8">
                      <WrapPanel ItemSpacing="10" LineSpacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="{Binding GradeBrush}" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding GradeLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                      </WrapPanel>
                      <ItemsControl ItemsSource="{Binding Verdicts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:VerdictRowViewModel">
                            <Grid ColumnDefinitions="120,*" Margin="0,4,0,4">
                              <Border Grid.Column="0" Background="{Binding GradeBrush}" CornerRadius="6"
                                      Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding GradeLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                              </Border>
                              <StackPanel Grid.Column="1" Spacing="2">
                                <!-- Wraps because the subject can be as long as
                                     "12th Gen Intel(R) Core(TM) i5-12400F (6 cores / 12 threads)",
                                     which pushed the measurement itself off the edge: the number
                                     the whole row exists to show was the first thing clipped. -->
                                <WrapPanel ItemSpacing="8" LineSpacing="2">
                                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Subject}" IsVisible="{Binding HasSubject}" Opacity="0.65" />
                                  <TextBlock Text="{Binding ValueText}" Opacity="0.85" FontWeight="SemiBold" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                           TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding Tips}" IsVisible="{Binding HasTips}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,1,0,0">
                                        <TextBlock Text="•" Opacity="0.8" />
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" MaxWidth="620" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Forecast}" IsVisible="{Binding HasForecast}"
                                           TextWrapping="Wrap" FontStyle="Italic" Opacity="0.65" FontSize="12" Margin="8,2,0,0" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="Receipt — everything this scan touched" IsVisible="{Binding HasResults}" Margin="0,0,6,0">
              <ItemsControl ItemsSource="{Binding ReceiptLines}" Margin="4,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas,Courier New,monospace" FontSize="11" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

    </Grid>
  </DockPanel>
</Window>
