<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PcHealth.Core</RootNamespace>
    <Description>Module contracts, verdict engine, consent model, report model, and orchestration. Contains no OS-specific or network code.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Rules\*.json" />
    <!--
      The advice catalog, one file per language (en.json; Step E adds vi.json). WithCulture="false"
      keeps every one in this assembly: MSBuild otherwise reads a culture-looking name segment as a
      satellite resource and moves the file out of it (STEP-B-SPEC 4, risk 3).
    -->
    <EmbeddedResource Include="Text\*.json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local-only trend history. No network component; the database never leaves the machine. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
