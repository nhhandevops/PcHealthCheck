<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PcHealth.Modules.Windows</RootNamespace>
    <!-- Required by the LibraryImport source generator (WinVerifyTrust / SLIsGenuineLocal P/Invokes). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Windows implementations of the health modules. Read-only by design; every external process launch goes through the receipt-logged process runner.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcHealth.Core\PcHealth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.11" />
    <!--
      MPL-2.0. Version 0.9.5+ deliberately: earlier builds shipped the WinRing0 driver that
      Microsoft Defender began quarantining as Trojan:Win32/Vigorf.A in 2025. Never downgrade.
    -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
