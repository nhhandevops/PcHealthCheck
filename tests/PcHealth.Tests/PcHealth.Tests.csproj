<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcHealth.Core\PcHealth.Core.csproj" />
    <ProjectReference Include="..\..\src\PcHealth.Ipc\PcHealth.Ipc.csproj" />
    <ProjectReference Include="..\..\src\PcHealth.Modules.Windows\PcHealth.Modules.Windows.csproj" />
    <ProjectReference Include="..\..\src\PcHealth.Net.Optional\PcHealth.Net.Optional.csproj" />
    <!--
      WorkerProtocolTests launches the real PcHealthCheck.exe. Referencing the app project
      (without importing its assets) guarantees the exe under test is rebuilt with the rest
      of the solution, instead of silently testing a stale binary from an earlier build.
    -->
    <ProjectReference Include="..\..\src\PcHealth.App\PcHealth.App.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
